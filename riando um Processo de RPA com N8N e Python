# Instale as bibliotecas necessárias (execute apenas na primeira vez)
!pip install yfinance requests -q

import yfinance as yf
import requests
import json

# 1. Defina os ativos que deseja monitorar (Ex: Petrobras, Vale e Bitcoin)
tickers = ["PETR4.SA", "VALE3.SA", "BTC-USD"]

# 2. Lista para armazenar os dados formatados
dados_formatados = []

for ticker in tickers:
    try:
        ativo = yf.Ticker(ticker)
        info = ativo.info
        
        # Extrai as informações principais e trata valores nulos
        preco = info.get("currentPrice") or info.get("regularMarketPrice", 0)
        variacao = info.get("regularMarketChangePercent", 0) * 100 # Converte para porcentagem
        
        dados_formatados.append({
            "ticker": ticker,
            "nome": info.get("shortName", "Nome não disponível"),
            "preco_atual": round(preco, 2),
            "variacao_percentual": round(variacao, 2),
            "recomendacao_analistas": info.get("recommendationKey", "N/A").upper()
        })
    except Exception as e:
        print(f"⚠️ Erro ao buscar dados de {ticker}: {e}")

# 3. Exibe o resultado no Colab para você conferir
